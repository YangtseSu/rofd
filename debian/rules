#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

export DH_VERBOSE = 1

# Air-gapped (intranet) builds: all crates are vendored in ./vendor (see
# .cargo/config.toml). Build hermetically with an isolated CARGO_HOME so the
# build host's ~/.cargo (mirrors, proxies) cannot influence the result, and
# forbid any network access outright.
export CARGO_HOME = $(CURDIR)/debian/.cargo-home
export CARGO_NET_OFFLINE = true

# pkg-config metadata reports the Debian version (the release identifier), not
# the Cargo crate version: the crate version lags the release train, and
# consumers compare against it (e.g. dependency('rofd-ffi', version: '>= 0.4.2')).
ROFD_FFI_VERSION = $(shell dpkg-parsechangelog -SVersion)

%:
	dh $@

override_dh_auto_build:
	cargo build --release --offline --locked -p rofd-ffi -p rofd --features rofd/qt-reader

override_dh_auto_install:
	install -D -m0755 target/release/rofd \
		debian/rofd/usr/bin/rofd
	install -D -m0644 debian/rofd.desktop \
		debian/rofd/usr/share/applications/rofd.desktop
	install -D -m0644 resources/logo.png \
		debian/rofd/usr/share/icons/hicolor/256x256/apps/rofd.png
	install -D -m0644 target/release/librofd_ffi.so \
		debian/librofd-ffi0/usr/lib/$(DEB_HOST_MULTIARCH)/librofd_ffi.so.0.4.0
	install -D -m0644 crates/rofd-ffi/include/rofd.h \
		debian/librofd-ffi-dev/usr/include/rofd.h
	install -d debian/librofd-ffi-dev/usr/lib/$(DEB_HOST_MULTIARCH)/pkgconfig
	sed -e 's/@VERSION@/$(ROFD_FFI_VERSION)/' \
	    -e 's/@MULTIARCH@/$(DEB_HOST_MULTIARCH)/' \
	    debian/rofd-ffi.pc.in \
	    > debian/librofd-ffi-dev/usr/lib/$(DEB_HOST_MULTIARCH)/pkgconfig/rofd-ffi.pc
	dh_link -plibrofd-ffi0 \
		usr/lib/$(DEB_HOST_MULTIARCH)/librofd_ffi.so.0.4.0 \
		usr/lib/$(DEB_HOST_MULTIARCH)/librofd_ffi.so.0
	dh_link -plibrofd-ffi-dev \
		usr/lib/$(DEB_HOST_MULTIARCH)/librofd_ffi.so.0.4.0 \
		usr/lib/$(DEB_HOST_MULTIARCH)/librofd_ffi.so

override_dh_auto_clean:
	cargo clean
	rm -rf debian/.cargo-home

# Vendored crates are checksummed by cargo (vendor/*/.cargo-checksum.json).
# Three debhelper steps would break those checksums or tracked sources, so
# all are neutralized:
#
#  - dh_clean deletes detritus like *.orig / *~ anywhere in the tree, which
#    includes files shipped inside vendored crates (vendor/*) and crate
#    patch copies (patches/*);
#  - dh_update_autotools_config replaces vendored config.guess / config.sub
#    with the system copies (the project itself has no autotools files).
override_dh_clean:
	dh_clean -X vendor/ -X patches/

override_dh_update_autotools_config:
